    <sql id="selectWaybillVo">
        select w.id, w.bill_no, w.container_no, w.container_status, w.customer, w.carrier,
               w.container_type, w.package_qty, w.weight, w.volume, w.cutoff_date, w.etd,
               w.transit_date, w.eta, w.customs_status, w.is_send_email, w.customs_date,
               w.customer_remark, w.route, w.pol, w.trans_port, w.pod, w.vessel_voyage,
               w.transit_time, w.do_date, w.release_time, w.transport_type, w.price_type,
               w.business_type, w.input_type, w.importer, w.7501_status, w.isf, w.is_myisf,
               w.check_code, w.check_progress, w.control_mode, w.salesman, w.operator,
               w.supplier, w.operate_user, w.inner_remark, w.create_by, w.create_time,
               w.update_by, w.update_time, w.remark, w.del_flag, w.user_id
        from biz_waybill w
    </sql>

    <select id="selectWaybillList" parameterType="Waybill" resultMap="WaybillResult">
        <include refid="selectWaybillVo"/>
        <where>
            <if test="billNo != null  and billNo != ''"> and w.bill_no = #{billNo}</if>
            <if test="containerNo != null  and containerNo != ''"> and w.container_no = #{containerNo}</if>
            <if test="containerStatus != null  and containerStatus != ''"> and w.container_status = #{containerStatus}</if>
            <if test="customer != null  and customer != ''"> and w.customer = #{customer}</if>
            <if test="cutoffDate != null "> and w.cutoff_date = #{cutoffDate}</if>
            <if test="params.beginEtd != null and params.beginEtd != '' and params.endEtd != null and params.endEtd != ''"> and w.etd between #{params.beginEtd} and #{params.endEtd}</if>
            <if test="params.beginEta != null and params.beginEta != '' and params.endEta != null and params.endEta != ''"> and w.eta between #{params.beginEta} and #{params.endEta}</if>
            <if test="doDate != null "> and w.do_date = #{doDate}</if>
            <if test="priceType != null  and priceType != ''"> and w.price_type = #{priceType}</if>
            <if test="businessType != null  and businessType != ''"> and w.business_type = #{businessType}</if>
            <if test="inputType != null  and inputType != ''"> and w.input_type = #{inputType}</if>
            <if test="isf != null "> and w.isf = #{isf}</if>
            <!-- 数据权限过滤，必须用 ${} 不能用 #{} -->
            ${params.dataScope}
        </where>
    </select>
    
    <select id="selectWaybillById" parameterType="Long" resultMap="WaybillResult">
        <include refid="selectWaybillVo"/>
        where id = #{id}
    </select>

