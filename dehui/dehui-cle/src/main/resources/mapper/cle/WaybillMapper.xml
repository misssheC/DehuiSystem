    <select id="selectMyWaybillList" parameterType="Waybill" resultMap="WaybillResult">
        SELECT
        w.id,
        w.bill_no,
        w.container_no,
        w.customer,
        w.carrier,
        w.container_type,
        w.package_qty,
        w.etd,
        w.eta,
        w.customs_status,
        w.route,
        w.pol,
        w.pod,
        w.create_time
        FROM biz_waybill w
        <where>
            w.del_flag = '0'
            <!-- 核心过滤：只查当前用户的数据 -->
            AND w.user_id = #{userId}
            <if test="billNo != null and billNo != ''">
                AND w.bill_no LIKE CONCAT('%', #{billNo}, '%')
            </if>
            <if test="containerNo != null and containerNo != ''">
                AND w.container_no LIKE CONCAT('%', #{containerNo}, '%')
            </if>
            <if test="customer != null and customer != ''">
                AND w.customer LIKE CONCAT('%', #{customer}, '%')
            </if>
            <if test="customsStatus != null and customsStatus != ''">
                AND w.customs_status = #{customsStatus}
            </if>
        </where>
        ORDER BY w.create_time DESC
    </select>
    
